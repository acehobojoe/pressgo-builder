*.zip
.claude
.env
.env.*
.svn-credentials
*.credentials
release-email-*.md
docs
phpunit.xml
phpcs.xml
.phpcs.xml
.editorconfig
mcp-server
includes/class-pressgo-updater.php
wordpress-org-assets
README.md
runtime-files.sha256
